# Copy to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather
BOT_TOKEN=<your telegram bot token>

# SQLAlchemy URL of the PostgreSQL database.
# Must use the postgresql+psycopg:// scheme (psycopg 3); plain postgresql://
# makes SQLAlchemy look for psycopg2, which is not installed.
# Host `postgres` is the Postgres container on the external `shared-network`.
DB_CONNECTION=postgresql+psycopg://roman_tech_bot:<password>@postgres:5432/roman_tech_bot

# Optional: speech-service for voice messages (https://github.com/qetlife/speech-service).
# Leave unset to turn voice messages off.
SPEECH_URL=http://speech:8000
# Only if the speech-service requires a token (its API_TOKEN)
# SPEECH_TOKEN=

# Optional: your Telegram user ID (⚙️ Settings → 🆔 My ID). Only this user can
# list failed messages with /failed. Leave unset to turn /failed off.
# ADMIN_TELEGRAM_ID=

# Optional: Google Calendar sync (docs/setup.md, Google Calendar). All four, or none.
# The OAuth client of the Google Cloud project:
# GOOGLE_CLIENT_ID=<…>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Where Google sends the user back; push notifications go to /google/push on the same host
# GOOGLE_REDIRECT_URI=https://calendar.romanis.xyz/oauth/callback
# Encrypts the Google logins in the database. Generate once, keep it (a new key unlinks everyone):
#   openssl rand -base64 32 | tr '+/' '-_'
# CALENDAR_KEY=

# Optional: where unexpected errors are kept (docs/setup.md, Unexpected errors).
# Default data/errors (the errors volume in Docker); empty: only the log.
# ERRORS_DIR=data/errors

# Optional: the web app, the bot's chat in a page (docs/setup.md, Web app)
# WEBAPP_URL=https://app.romanis.xyz
