# Copy to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather
BOT_TOKEN=<your telegram bot token>

# SQLAlchemy URL of the PostgreSQL database.
# Must use the postgresql+psycopg:// scheme (psycopg 3); plain postgresql://
# makes SQLAlchemy look for psycopg2, which is not installed.
# Host `postgres` is the Postgres container on the external `shared-network`.
DB_CONNECTION=postgresql+psycopg://roman_tech_bot:<password>@postgres:5432/roman_tech_bot
